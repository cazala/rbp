{
  "name": "resurrect-workspace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --recursive run check",
    "dev:beacon-deployer": "pnpm --dir apps/beacon-deployer run dev",
    "dev:explorer": "pnpm --dir apps/explorer run dev",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "wrangler": "4.128.0"
  }
}
